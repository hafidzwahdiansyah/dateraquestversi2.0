# =========================================================
# DateraQuest 2.0 - Environment Variables (contoh)
# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# JANGAN commit file ".env" yang asli ke git.
# =========================================================

# ---------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=dateraquest_db
DB_USER=root
DB_PASS=

# ---------------------------------------------------------
# Google OAuth 2.0
# Dapatkan dari Google Cloud Console > APIs & Services > Credentials
# ---------------------------------------------------------
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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ni
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ---------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------
APP_URL=http://localhost:8080
APP_ENV=local
SESSION_NAME=dateraquest_session
